    {
      "dot": "cyan",
      "title": "一本の実装が CPU と GPU で動く",
      "items": [
        "Numo / Cumo を直接書かず、XM 経由で書く",
        "既定は Numo (CPU)、GPU=1 で Cumo",
        "XF で fp32 / fp16 / bf16 を切り替える"
      ]
    },
    {
      "dot": "emerald",
      "title": "6 モデルが Ops を共有する",
      "items": [
        "GPT-2・Llama 2・Mamba は Generator で生成し、Sampler と KVCache を使う",
        "Switch・Whisper は自前の生成ループ、ResNet-18 は分類",
        "Ops は cumo の融合カーネルがあれば使い、無ければ元の式に落ちる"
      ]
    },
    {
      "dot": "rose",
      "title": "正しさは参照の出力が決める",
      "items": [
        "llm.c・llama2.c・mamba.c と、transformers の 2 系統",
        "受け入れ条件はトークン列かクラス番号の完全一致",
        "Python の比較実装が同じ重みを読み、速さを突き合わせる"
      ]
    }
